<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        RESOLVED (2026-08-10) — access-scoping decision from Rami, see
        SPRINT_BACKLOG.md Task 7. Do NOT reuse stock.group_stock_manager or
        System Administrator for kiosk device management. This is a brand
        new, dedicated, standalone group:
          - scoped to exactly the price_checker.kiosk model (full CRUD),
            nothing else;
          - no `implied_ids` in either direction — it does not imply, and is
            not implied by, any existing group (Inventory/Stock Manager,
            Settings/Administration, etc.);
          - membership is assigned manually, per person, by an admin — never
            auto-granted.
    -->

    <record id="module_category_price_checker" model="ir.module.category">
        <field name="name">Price Checker</field>
        <field name="description">Access rights for the Price Checker kiosk feature.</field>
        <field name="sequence">50</field>
    </record>

    <record id="group_kiosk_admin" model="res.groups">
        <field name="name">Kiosk Administrator</field>
        <field name="category_id" ref="module_category_price_checker"/>
        <field name="comment">Can create, edit, and regenerate tokens for Price Checker
kiosk devices (price_checker.kiosk). Standalone group: not implied by, and does
not imply, any other group. Grant manually, per person.</field>
    </record>

    <!--
        Additional hardening beyond the Task 7 acceptance criteria (not
        explicitly required, but consistent with this module's existing
        multi-company-safety conventions — see _company_domain() in
        controllers/price_checker_controller.py): a kiosk-admin in one
        company should not see or edit another company's kiosk devices.
    -->
    <record id="price_checker_kiosk_company_rule" model="ir.rule">
        <field name="name">Price Checker Kiosk: multi-company</field>
        <field name="model_id" ref="model_price_checker_kiosk"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_kiosk_admin'))]"/>
    </record>

</odoo>
